rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function logged(){return request.auth != null;}
  function admin(){return logged() && request.auth.token.email == 'leifolsen@gmx.de';}
  function myRole(){return logged() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role : 'none';}
  function role(){return admin() ? 'admin' : (logged() && request.auth.token.email == 'leif@gtigmbh.de' ? 'requester' : myRole());}
  function seeStock(){return role() in ['admin','staff','viewer'];}
  function shipper(){return role() in ['admin','staff'];}
  match /pushConfig/{id}{
   allow read: if admin();
   allow create,update: if admin() && id=='public' && request.resource.data.keys().hasOnly(['vapidKey']) && request.resource.data.vapidKey is string && request.resource.data.vapidKey.matches('^[A-Za-z0-9_-]{87}$');
   allow delete: if admin();
  }
  match /pushDevices/{id}{
   allow read,delete: if admin();
   allow create,update: if admin() && request.resource.data.keys().hasOnly(['ownerUid','token','appUrl','updatedAt']) && request.resource.data.ownerUid==request.auth.uid && request.resource.data.token is string && request.resource.data.token.size()>0 && request.resource.data.token.size()<4096 && request.resource.data.appUrl is string && request.resource.data.appUrl.size()<500 && request.resource.data.appUrl.matches('https://.*') && request.resource.data.updatedAt==request.time;
  }
  match /users/{uid}{
   allow get: if admin() || (logged() && request.auth.uid==uid);
   allow list, create, update: if admin();
   allow delete: if false;
  }
  match /orders/{id}{
   allow create: if admin() || logged() && role() in ['admin','staff','requester'] && request.resource.data.keys().hasOnly(['buyer','recipient','address','quantity','replyEmail','notifyAdmin','status','createdAt']) && request.resource.data.status=='pending' && request.resource.data.get('notifyAdmin',false) is bool && request.resource.data.buyer is string && request.resource.data.buyer.size()>0 && request.resource.data.buyer.size()<=150 && request.resource.data.recipient is string && request.resource.data.recipient.size()>0 && request.resource.data.recipient.size()<=150 && request.resource.data.address is string && request.resource.data.address.size()>0 && request.resource.data.address.size()<=500 && request.resource.data.replyEmail is string && request.resource.data.replyEmail.size()<=200 && request.resource.data.quantity is int && request.resource.data.quantity>0 && request.resource.data.quantity<=10000 && request.resource.data.createdAt==request.time;
   allow read: if shipper();
   allow update: if admin() || shipper() && resource.data.status=='pending' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','shippedAt','shippedBy','cancelledAt','cancelledBy']) && ((request.resource.data.status=='shipped' && request.resource.data.shippedBy==request.auth.uid && request.resource.data.shippedAt==request.time && existsAfter(/databases/$(database)/documents/movements/$("ship_"+id)) && getAfter(/databases/$(database)/documents/movements/$("ship_"+id)).data.delta == -resource.data.quantity) || (request.resource.data.status=='cancelled' && request.resource.data.cancelledBy==request.auth.uid && request.resource.data.cancelledAt==request.time));
   allow delete: if admin();
  }
  match /movements/{id}{
   allow read: if seeStock();
   allow create: if admin() || request.resource.data.delta is int && request.resource.data.delta!=0 && request.resource.data.actor==request.auth.uid && request.resource.data.createdAt==request.time && !id.matches('ship_.*') && request.resource.data.keys().hasOnly(['delta','reason','actor','createdAt']) || shipper() && id.matches('ship_.*') && request.resource.data.keys().hasAll(['orderId','delta','actor','reason','createdAt']) && request.resource.data.actor==request.auth.uid && request.resource.data.createdAt==request.time && id=='ship_'+request.resource.data.orderId && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status=='shipped' && get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status=='pending' && request.resource.data.delta == -get(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.quantity;
   allow update,delete: if admin();
  }
 }
}
